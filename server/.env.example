PUERTO=3000
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=espe_connect
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=

# Usa "console" para desarrollo sin enviar correos y "smtp" para entregarlos.
FRONTEND_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=console

# Gmail con contraseña de aplicación (nunca la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ESPEConnect <correo@gmail.com>"
